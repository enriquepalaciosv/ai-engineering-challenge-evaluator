{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build --workspace @challenge/dashboard && rm -rf dist && cp -R apps/dashboard/dist dist",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "challenge/*": true
    }
  }
}
